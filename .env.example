# Voice providers (fill only the providers you use)
# Web and voice services must share this directory for live tool permission settings.
# VOICEAGENT_TOOL_PERMISSIONS_DIR=/absolute/path/to/tool-permissions
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=llm-your-workspace

# TTS provider: doubao-direct (default), bailian, or bella.
# Bailian uses one duplex WebSocket for incremental LLM text and 24 kHz PCM16 audio.
# VOICEAGENT_TTS_BACKEND=bailian
BAILIAN_API_HOST=llm-your-workspace.cn-beijing.maas.aliyuncs.com
BAILIAN_TTS_MODEL=cosyvoice-v3-flash
BAILIAN_TTS_VOICE=longanhuan_v3
# Optional override for browser-created cloned voices. Keep it aligned with
# BAILIAN_TTS_MODEL so the returned voice ID is usable for synthesis.
# BAILIAN_VOICE_CLONE_MODEL=cosyvoice-v3-flash
# Public S3-compatible storage used only while Bailian reads a clone sample.
# The uploaded WAV is deleted as soon as enrollment returns.
S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
S3_BUCKET=
S3_REGION=auto
S3_AK=
S3_SK=
S3_PREFIX=openrealtime/
S3_PUBLIC_BASE_URL=https://your-public-bucket.example.com
# Optional provider instruction, e.g. emotional delivery or a supported dialect.
# BAILIAN_TTS_INSTRUCTION=
# Optional exact endpoint override; normally BAILIAN_API_HOST is enough.
# BAILIAN_TTS_WS_URL=wss://llm-your-workspace.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference

# Optional hosted avatar renderer. When blank, authorized users enter their own
# Anam key at use time; the browser receives only a short-lived session token.
ANAM_API_KEY=
# ID returned by Anam's /v1/avatars API after uploading a one-shot image.
ANAM_AVATAR_ID=
ANAM_AVATAR_MODEL=cara-4
LIVEAVATAR_API_KEY=
# Required Avatar ID from the LiveAvatar dashboard. It is deliberately left
# empty: never silently substitute a stock person for the selected identity.
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_SANDBOX=true

# Optional HappyImage account used by Avatar Studio. The key remains server-side;
# generated images are copied into the Avatar source instead of retaining a
# browser session or cross-application Cookie.
HAPPYIMAGE_API_URL=http://127.0.0.1:8000
HAPPYIMAGE_API_KEY=
# Optional durable storage root for owned Avatar records and immutable source images.
# Defaults to .openrealtime/avatar-catalog under the application directory.
AVATAR_CATALOG_DIR=

# Optional image-to-video provider for creating silent Motion Base Videos.
# Server-side only. Vidu web free credits and API credits are separate.
# China platform: https://api.vidu.cn; international platform: https://api.vidu.com
VIDU_API_URL=https://api.vidu.cn
VIDU_API_KEY=
# Comma-separated trusted result/CDN domain suffixes. Add the exact Vidu CDN
# domain returned for your account/region; private DNS answers are always denied.
VIDU_RESULT_HOST_ALLOWLIST=vidu.cn,vidu.com

# LTX API (Avatar 动作图生视频；默认使用 ltx-2-3-fast)
LTX_API_URL=https://api.ltx.io
LTX_API_KEY=
# Optional: when blank, authorized users enter their own MiniMax key when generating video.
MINIMAX_API_KEY=
# 可选：生产环境建议按实际 result.video_url 域名配置逗号分隔白名单。
LTX_RESULT_HOST_ALLOWLIST=

# Non-production only. Grants admin-equivalent avatar test permissions to
# same-origin requests on localhost; production ignores this flag.
AVATAR_LOCAL_TEST_MODE=false
# Durable Motion Base storage. Local test mode falls back to the local
# PostgreSQL socket; set an explicit DSN when yours differs. Migrations run at
# local test startup only and remain disabled when local test mode is off.
# AVATAR_ASSET_POSTGRES_DSN=postgresql:///postgres?host=/tmp
AVATAR_ASSET_POSTGRES_SCHEMA=voiceagent

# Optional local Motion-driven Portrait Animation worker. The setup script
# installs a pinned official LivePortrait runtime under this default path.
# Production task creation remains disabled until a durable coordinator and
# remote/persistent worker deployment are configured.
# LIVEPORTRAIT_RUNTIME_ROOT=/absolute/path/to/models/liveportrait
# LIVEPORTRAIT_WRAPPER_PYTHON=python3
# LIVEPORTRAIT_TASK_ROOT=/private/path/to/openrealtime-liveportrait-tasks

# Self-hosted Avatar Renderer lifecycle. `managed` prewarms the local MVP
# adapter during application startup (requires the gitignored LiveTalking
# GPU runtime under models/livetalking/ — see scripts/avatar_services.sh);
# `external` connects to a separately supervised Linux deployment; `disabled`
# keeps self-hosted rendering off, which is the right default for anyone who
# hasn't set up the LiveTalking runtime — `pnpm dev` runs fine without it.
OPENREALTIME_AVATAR_RENDERER_MODE=disabled
OPENREALTIME_AVATAR_RENDERER_URL=http://127.0.0.1:8010
# Optional dedicated Wav2Lip 96 compatibility renderer (managed mode defaults to port 8011).
# OPENREALTIME_AVATAR_RENDERER_WAV2LIP96_URL=http://127.0.0.1:8011
# 1 keeps every Wav2Lip prediction; 2 interpolates every other prediction for slower GPUs.
OPENREALTIME_WAV2LIP_INFERENCE_STRIDE=2
# Mouth prediction blend (0..1); restart the renderer after changes. --blend overrides this.
OPENREALTIME_WAV2LIP_BLEND=0.5
# Linux/external renderer deployments must allow this web-service origin.
OPENREALTIME_AVATAR_RENDERER_REQUEST_ORIGIN=http://127.0.0.1:3010
# Browser-reachable origin. Set this when the internal Linux address differs
# from the public HTTPS/TURN-facing renderer address.
# OPENREALTIME_AVATAR_RENDERER_PUBLIC_URL=https://avatar.example.com
# Legacy compatibility only; use OPENREALTIME_AVATAR_RENDERER_MODE instead.
# OPENREALTIME_START_AVATAR_SERVICES=true

# Endpoint identity. Development mode is loopback-only and logs an unsafe-mode
# warning. Production uses a trusted proxy header or secure same-site cookie.
VOICEAGENT_ENDPOINT_AUTH_MODE=development
VOICEAGENT_WS_HOST=127.0.0.1
# For static_bearer mode, set every value below and use a high-entropy token
# of at least 32 characters.
# VOICEAGENT_ENDPOINT_AUTH_TOKEN=replace-with-a-high-entropy-secret
# VOICEAGENT_TENANT_ID=tenant-1
# VOICEAGENT_USER_ID=user-1
# VOICEAGENT_DEVICE_ID=browser

# Realtime endpointing. Lower values respond faster but may split natural pauses.
VOICEAGENT_FAST_RESUME_WINDOW_S=5
VOICEAGENT_RECOVERY_DEADLINE_S=15
# Process-local Voice Session admission profile. Tune from M5 load evidence.
VOICEAGENT_MAX_ACTIVE_VOICE_SESSIONS=8
VOICEAGENT_MAX_ASR_SESSIONS=8
VOICEAGENT_MAX_TTS_SESSIONS=8
VOICEAGENT_MAX_EVENT_LOOP_LAG_MS=200
VOICEAGENT_MAX_PROCESS_MEMORY_BYTES=1073741824
VOICEAGENT_MAX_AUDIO_QUEUE_BYTES=67108864
VOICEAGENT_AUDIO_QUEUE_RESERVATION_BYTES=4194304
VOICEAGENT_CAPACITY_RETRY_AFTER_MS=1000
VOICEAGENT_VAD_SILENCE_MS=256
VOICEAGENT_VAD_ONSET_MS=96
VOICEAGENT_VAD_THRESHOLD=0.6
VOICEAGENT_LATE_ASR_RECOVERY_MS=2000
VOICEAGENT_RESPONSE_FIRST_TEXT_TIMEOUT_S=5
VOICEAGENT_TTS_CANCEL_TIMEOUT_MS=300
DOUBAO_ASR_END_WINDOW_MS=256
DOUBAO_ASR_PACKET_MS=100
# Flush a sub-packet tail and briefly wait for its final transcript at turn commit.
DOUBAO_ASR_COMMIT_WAIT_MS=128
VOICEAGENT_EOT_LLM_TIMEOUT_MS=5000
# DeepSeek ordinary Brain replies and semantic EoT both use Responses.
# Tool-calling keeps its dedicated Chat Completions protocol.
VOICEAGENT_LLM_API_STYLE=responses
# Set chat_completions for semantic-EoT rollback independently.
VOICEAGENT_EOT_LLM_API_STYLE=responses
# Committed user/assistant messages kept as the stable semantic-EoT prefix.
VOICEAGENT_EOT_HISTORY_MESSAGES=8
VOICEAGENT_EOT_HISTORY_CHARS=4000
# Nuanced playback-time interruptions wait for stable ASR text. Exact stop
# phrases still use the immediate local rule path without this delay.
VOICEAGENT_SEMANTIC_INTERRUPTION_PARTIAL_CHARS=24
VOICEAGENT_SEMANTIC_INTERRUPTION_IDLE_MS=320
VOICEAGENT_RESPONSE_CANCEL_TIMEOUT_S=0.8
# `pnpm dev:server` enables local FireRedChat by default using
# models/fireredchat-turn-detector. Override this only when the model lives elsewhere.
# FireRed stays on the fast-complete/fallback path until calibrated on real sessions.
# VOICEAGENT_EOT_FIRERED_MODEL_DIR=/absolute/path/to/FireRedChat-turn-detector
VOICEAGENT_EOT_FIRERED_LANGUAGE=chinese
VOICEAGENT_EOT_FIRERED_THRESHOLD=0.5
VOICEAGENT_EOT_FIRERED_STRATEGY=fast_complete_fallback
VOICEAGENT_EOT_FIRERED_FAST_COMPLETE_THRESHOLD=0.5
VOICEAGENT_EOT_FIRERED_INTRA_OP_THREADS=2
VOICEAGENT_EOT_FIRERED_MAX_CONCURRENCY=2

# Doubao TTS receives LLM deltas and returns audio in one duplex session.

# Admin diagnostics. Password must be 12+ chars; secret must be 32+ chars.
VOICEAGENT_ADMIN_USERNAME=admin
VOICEAGENT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
VOICEAGENT_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional for local development and tests only. Production always ignores autofill.
VOICEAGENT_ENV=development
VOICEAGENT_ADMIN_AUTOFILL=false

# Ordinary user login and account-saved API Keys (separate from administrator auth).
# Register https://your-site.example/api/user/callback in the Casdoor application.
# Apply PostgreSQL migrations through 0022 before enabling account routes.
VOICEAGENT_CASDOOR_ISSUER=
VOICEAGENT_CASDOOR_CLIENT_ID=
VOICEAGENT_CASDOOR_CLIENT_SECRET=
VOICEAGENT_PUBLIC_ORIGIN=
VOICEAGENT_USER_SESSION_SECRET=
# Generate 32 random bytes and encode them as base64url. Keep the value stable
# so saved user keys remain decryptable; never publish it or reuse the admin secret.
VOICEAGENT_CREDENTIAL_ENCRYPTION_KEY=
VOICEAGENT_POSTGRES_DSN=
VOICEAGENT_POSTGRES_SCHEMA=voiceagent
# Public realtime voice is opt-in. Run the voice server with
# VOICEAGENT_ENDPOINT_AUTH_MODE=public_ticket and proxy /voice to its WebSocket
# endpoint before setting this to true. Keep provider spending hard-capped.
VOICEAGENT_PUBLIC_VOICE_ENABLED=false
VOICEAGENT_PLATFORM_ASR_CONCURRENCY=1
VOICEAGENT_PLATFORM_TTS_CONCURRENCY=1
VOICEAGENT_PLATFORM_VOICE_SESSION_SECONDS=180
# Browser-visible endpoint, served over wss:// on an HTTPS website.
NEXT_PUBLIC_VOICE_WS_URL=

# Internal avatar artifacts. Production still requires an administrator session.
AVATAR_EVALUATION_PREVIEW_ENABLED=false
# Optional development-only bypass. Use pnpm dev/dev:web so Next binds loopback.
AVATAR_EVALUATION_LOCAL_PREVIEW_ENABLED=false
# Do not persist AVATAR_EVALUATION_LOOPBACK_BOUND. scripts/dev_web.sh sets it
# only for the Next.js process that it binds to 127.0.0.1.
# Override only if port 3010 is already occupied.
OPENREALTIME_WEB_PORT=3010

# Optional local conversation and Memory catalogs. In production, place them on
# the same durable volume used by both the web and voice processes.
# CONVERSATION_HISTORY_DIR=/var/lib/openrealtime/conversations
# VOICEAGENT_MEMORY_DIR=/var/lib/openrealtime/memory
# ROLE_CATALOG_DIR=/var/lib/openrealtime/role-catalog
# KNOWLEDGE_CATALOG_DIR=/var/lib/openrealtime/knowledge
# Web imports validate and pin public IPv4 addresses. For proxy Fake-IP DNS,
# opt in to the fixed Cloudflare HTTPS resolver; private targets remain blocked.
# KNOWLEDGE_WEB_DNS=cloudflare-doh
# Delete conversation history after this many days; unset to retain it.
# VOICEAGENT_CONVERSATION_RETENTION_DAYS=90

# Voice Runtime tools: FAST tools wait inline; VARIABLE tools acknowledge first.
VOICEAGENT_DEMO_TOOLS=1
# Exact origins (scheme, host, port) allowed for custom Function/API/MCP tools.
# Empty disables custom network tools. Set only operator-reviewed origins.
VOICEAGENT_TOOL_ALLOWED_ORIGINS=
# Paid video generation in production remains off until an operator opts in
# with persistent ledger and upload-cache paths on the shared durable volume.
OPENREALTIME_PAID_GENERATION_ENABLED=false
# OPENREALTIME_GENERATION_TASKS_PATH=/var/lib/openrealtime/generation-jobs/video-generation.json
# MINIMAX_UPLOAD_CACHE_PATH=/var/lib/openrealtime/minimax-upload-cache.json
# Signed-in users' saved MiniMax videos; required for the personal motion library in production.
# OPENREALTIME_PERSONAL_MOTION_PATH=/var/lib/openrealtime/personal-motion
# Skip the Delegation Ack when a realtime tool finishes inside this window.
VOICEAGENT_SLOW_TOOL_ACK_DELAY_MS=500
# Byte search retries transient TLS/network failures immediately. The initial
# request plus two retries stays inside the VARIABLE tool's 8-second grant.
BYTE_WEB_SEARCH_MAX_ATTEMPTS=3
# Phase 1 production always uses the stateful Cascaded Realtime composition.
# VOICEAGENT_REALTIME_PROFILE_PATH=config/realtime-profile.json

# Lip Forcing 14B talking material generation on the existing GPU host.
# Preferred: run scripts/lipforcing_service.sh tunnel and use the GPU HTTP API.
# LIPFORCING_API_URL=http://127.0.0.1:8190
# LIPFORCING_API_TOKEN=copy-with-scripts-lipforcing_service-sh-token
# Legacy one-shot SSH execution remains available when LIPFORCING_API_URL is blank.
# LIPFORCING_SSH_HOST=dev
# LIPFORCING_REMOTE_ROOT=/root/lipsync-eval/lipforcing-eval
# LIPFORCING_REMOTE_PYTHON=/root/lipsync-eval/venv-lipforcing/bin/python
# LIPFORCING_REMOTE_ENTRYPOINT=infer_lowmem.py
# LIPFORCING_JOB_ROOT=/var/lib/openrealtime/lipforcing-jobs

# Exact HTTPS origins that signed-in users may choose for their personal
# lip-sync service. Empty disables personal service configuration and prevents
# user-supplied URLs from reaching private networks.
VOICEAGENT_PERSONAL_LIPSYNC_ALLOWED_ORIGINS=
# Coordinator recovery ceiling; raw VAD restarts do not reset ASR revision age.
VOICEAGENT_TURN_RECOVERY_TIMEOUT_MS=10000
# Independent semantic chunks; disable for comparison with legacy partial scheduling.
VOICEAGENT_SEMANTIC_CHUNKS_ENABLED=1
VOICEAGENT_INTERRUPTION_CHUNK_CHARS=5
VOICEAGENT_CHUNK_STABILITY_MS=120
# Prepare only LLM on stable ordinary input. TTS remains commit-gated by default.
VOICEAGENT_RESPONSE_PREFETCH_ENABLED=1
VOICEAGENT_RESPONSE_PREFETCH_TTS_ENABLED=0
# Private permitted-sentence continuation; requires response prefetch above.
# Experimental until physical playback/provider acceptance is complete.
VOICEAGENT_SENTENCE_HANDOFF_PREFETCH_ENABLED=0

# Semantic plugins: llm (default) or jev, independently selectable.
VOICEAGENT_EOT_PROVIDER=llm
VOICEAGENT_INTERRUPTION_PROVIDER=llm
JEV_API_KEY=
VOICEAGENT_JEV_MODEL=jev-1.13.0
VOICEAGENT_JEV_TIMEOUT_MS=2000
# Shared application-wide JEV request concurrency (includes all sessions).
VOICEAGENT_JEV_MAX_CONCURRENCY=2
VOICEAGENT_JEV_EOT_MIN_CONFIDENCE=0.8
# Confidence needed to suppress a stable semantic backchannel.
VOICEAGENT_BACKCHANNEL_CONFIDENCE=0.95

# Per-session semantic candidate concurrency (independent of shared JEV slots).
VOICEAGENT_SEMANTIC_CHUNK_CONCURRENCY=2

# Server-only, independent random secret (32+ characters) for 15-minute,
# exact-Session diagnostic read grants. Empty keeps machine access disabled.
# Rotation invalidates every outstanding grant; never use a NEXT_PUBLIC_ key.
OPENREALTIME_DIAGNOSTICS_ACCESS_SECRET=

# Logical ASR input budgets. Overflows stop processing and report missing/durable evidence.
VOICEAGENT_INPUT_MAX_TEXT_BYTES=16384
VOICEAGENT_INPUT_MAX_REVISIONS=2048
VOICEAGENT_INPUT_MAX_CHUNKS=2048
VOICEAGENT_INPUT_MAX_DURATION_MS=120000
VOICEAGENT_INPUT_MAX_EVIDENCE_BYTES=2097152
VOICEAGENT_INPUT_EVIDENCE_TIMEOUT_MS=1000
