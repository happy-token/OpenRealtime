# Copy to .env in this directory, or export these variables in the shell.
# Runtime roots mounted into Linux containers MUST contain Linux-compatible .venv.
LIVEPORTRAIT_RUNTIME_ROOT=./runtime/liveportrait
WAV2LIP_RUNTIME_ROOT=./runtime/wav2lip
MUSETALK_RUNTIME_ROOT=./runtime/musetalk
LIPFORCING_RUNTIME_ROOT=./runtime/lipforcing

LIVEPORTRAIT_PORT=18193
WAV2LIP_PORT=18192
MUSETALK_PORT=18191
LIPFORCING_PORT=18190

# Set strong random tokens outside an isolated local test machine.
LIVEPORTRAIT_SERVICE_TOKEN=
WAV2LIP_SERVICE_TOKEN=
MUSETALK_SERVICE_TOKEN=
LIPFORCING_SERVICE_TOKEN=
