# Used by Compose for ${...} substitution; copy to .env in this directory.
# Password must be URL-safe because it is also placed in the PostgreSQL DSN.
OPENREALTIME_POSTGRES_PASSWORD=replace-with-url-safe-random-password
VOICEAGENT_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64url
VOICEAGENT_POSTGRES_SCHEMA=voiceagent
OPENREALTIME_PUBLIC_ORIGIN=https://realtime.happy-token.cn
OPENREALTIME_PUBLIC_VOICE_WS_URL=wss://realtime.happy-token.cn/voice
OPENREALTIME_WEB_PORT=3010
OPENREALTIME_VOICE_PORT=8765
# Keep false until the reverse proxy and WebSocket admission are verified.
VOICEAGENT_PUBLIC_VOICE_ENABLED=false
