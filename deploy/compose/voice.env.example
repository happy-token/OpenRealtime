# Copy to voice.env. These are injected only into the Python voice container.
# Fill the ASR, LLM and TTS providers used by this deployment.
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DASHSCOPE_API_KEY=
BAILIAN_API_HOST=
VOICEAGENT_PLATFORM_ASR_CONCURRENCY=1
VOICEAGENT_PLATFORM_TTS_CONCURRENCY=1
VOICEAGENT_PLATFORM_VOICE_SESSION_SECONDS=180
VOICEAGENT_DEMO_TOOLS=1
OPENREALTIME_AVATAR_RENDERER_MODE=disabled
