[Unit]
Description=OpenRealtime Lip Forcing GPU API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/openrealtime-lipforcing-service
EnvironmentFile=-/etc/openrealtime-lipforcing.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/openrealtime-lipforcing-service/venv/bin/uvicorn app:create_app --factory --host 127.0.0.1 --port 8190 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
PrivateTmp=true
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
