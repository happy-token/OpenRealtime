{
  "name": "openrealtime-web",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/happy-token/OpenRealtime",
  "repository": {
    "type": "git",
    "url": "https://github.com/happy-token/OpenRealtime.git"
  },
  "scripts": {
    "dev": "concurrently -n web,server,avatar -c blue,green,magenta \"OPENREALTIME_WAIT_FOR_AVATAR_SERVICES=true pnpm run dev:web\" \"pnpm run dev:server\" \"pnpm run dev:avatar\"",
    "dev:web": "bash scripts/dev_web.sh",
    "dev:server": "bash scripts/dev_server.sh",
    "dev:avatar": "bash scripts/avatar_services.sh start",
    "build": "next build",
    "prestart": "npm run build",
    "start": "concurrently --kill-others-on-fail -n web,server,avatar -c blue,green,magenta \"OPENREALTIME_WAIT_FOR_AVATAR_SERVICES=true pnpm run start:web\" \"pnpm run dev:server\" \"pnpm run dev:avatar\"",
    "start:web": "bash scripts/start_web.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:media:local": "RUN_LOCAL_MEDIA=1 vitest run src/lib/liveportrait-actions.test.ts src/lib/opentalking-avatar-catalog.test.ts src/lib/lip-sync-comparison-manifest.test.ts",
    "test:e2e": "playwright test",
    "test:voice": "bash scripts/test_voice_runtime.sh",
    "test:voice:live": "RUN_LIVE=1 .venv/bin/python -m pytest -q tests/live/test_doubao_direct_asr_live.py tests/live/test_doubao_direct_tts_live.py tests/live/test_deepseek_llm_live.py"
  },
  "dependencies": {
    "@anam-ai/js-sdk": "4.25.0",
    "@heygen/liveavatar-web-sdk": "0.0.18",
    "@ncdai/react-wheel-picker": "1.2.3",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.3",
    "motion": "^13.4.0",
    "next": "^15.4.6",
    "openid-client": "^6.8.8",
    "orb-ui": "0.7.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "^1.3.0",
    "sharp": "0.34.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@webgpu/types": "0.1.66",
    "concurrently": "^9.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.4.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
